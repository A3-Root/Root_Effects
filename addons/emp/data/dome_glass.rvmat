// Frosted glass for the EMP dome: unlit by diffuse and point lights, lit by
// ambient, sun specular and the environment; tint and opacity come from camo.
ambient[] = {1, 1, 1, 1};
diffuse[] = {0, 0, 0, 1};
forcedDiffuse[] = {0, 0, 0, 0};
emmisive[] = {0, 0, 0, 1};
specular[] = {1, 1, 1, 1};
specularPower = 400;
renderFlags[] = {"NoZWrite"};
PixelShaderID = "Super";
VertexShaderID = "Super";
class Stage1 {
    texture = "z\root_effects\addons\emp\data\dome_glass_nohq.paa";
    uvSource = "tex";
    class uvTransform {
        aside[] = {8, 0, 0};
        up[] = {0, 8, 0};
        dir[] = {0, 0, 0};
        pos[] = {0, 0, 0};
    };
};
